<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="10dp" android:layout_marginBottom="12dp">
 <ImageView android:id="@+id/placeImage" android:layout_width="match_parent" android:layout_height="174dp" android:scaleType="centerCrop" android:contentDescription="Destination photo"/>
 <TextView android:id="@+id/placeCountry" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#246A5B" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="9dp"/>
 <TextView android:id="@+id/placeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#193F36" android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
 <TextView android:id="@+id/placeTagline" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#5C7067" android:textSize="14sp" android:layout_marginTop="2dp"/>
</LinearLayout>
